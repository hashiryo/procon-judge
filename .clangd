# Zed (clangd) 用。pj がコンパイルのときに使うフラグ (environments.toml の local) と、
# 探索パス (pj/build.py の include_dirs: lib、問題のディレクトリ、harness、problems、
# third_party/simde) を同じ順で再現する。
# clangd は開いたファイルのディレクトリでコンパイルするので、相対の -I はそこから
# 解決される。それを使って問題のディレクトリを表す。提出 (<問題>/submissions/*.hpp) を
# 開いたときは -I.. が、base.cpp を開いたときは -I. が問題のディレクトリになる。
# 問題のディレクトリの common.hpp を submissions/ から引く提出は、これで解決する。
# 残りは開いたファイルの場所によらないので絶対パスで書く。
CompileFlags:
  Add:
    - -std=gnu++23
    - -Wall
    - -Wextra
    - -DUSE_SIMDE
    - -DSIMDE_ENABLE_NATIVE_ALIASES
    - -I/Users/01058120/code/asobi/procon/algo/procon-judge/lib
    - -I.
    - -I..
    - -I/Users/01058120/code/asobi/procon/algo/procon-judge/harness
    - -I/Users/01058120/code/asobi/procon/algo/procon-judge/problems
    - -I/Users/01058120/code/asobi/procon/algo/procon-judge/third_party/simde
